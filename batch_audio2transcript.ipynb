import os
import json
import boto3
from botocore.exceptions import ClientError

# ==========================================
# STAGE 1 CONFIGURATION
# ==========================================
INPUT_BUCKET = "test-audit-ars"
INPUT_PREFIX = ""  # e.g., "raw_audio/" or leave "" for root

OUTPUT_BUCKET = "test-audit-ars"
TRANSCRIPT_PREFIX = "transcripts/"

JOB_QUEUE = "queue-asr"
JOB_DEFINITION = "job-def-asr"

HF_TOKEN = "T"
LANGUAGE = "hi"
NUM_SPEAKERS = 2

AUDIO_EXTENSIONS = {'.mp3', '.wav', '.m4a', '.flac'}
# ==========================================

s3 = boto3.client('s3', region_name='ap-south-1')
batch = boto3.client('batch', region_name='ap-south-1')

CHUNK_SIZE = 50  # tune based on how long each file takes; start conservative, raise later 5o audio file process at a time
MANIFEST_PREFIX = "manifests/"  # folder in OUTPUT_BUCKET to store manifest files




def list_audio_files(bucket, prefix):
    paginator = s3.get_paginator('list_objects_v2')
    pages = paginator.paginate(Bucket=bucket, Prefix=prefix)
    audio_files = []
    for page in pages:
        if 'Contents' in page:
            for obj in page['Contents']:
                key = obj['Key']
                if os.path.splitext(key)[1].lower() in AUDIO_EXTENSIONS:
                    audio_files.append(key)
    return audio_files


def is_transcript_ready(base_name):
    audit_key = f"{TRANSCRIPT_PREFIX}{base_name}_transcript.json"
    try:
        s3.head_object(Bucket=OUTPUT_BUCKET, Key=audit_key)
        return True
    except ClientError as e:
        if e.response['Error']['Code'] == '404':
            return False
        raise


def chunk_list(items, size):
    for i in range(0, len(items), size):
        yield items[i:i + size]


def main():
    print(f"🔍 Scanning s3://{INPUT_BUCKET}/{INPUT_PREFIX} for audio files...")
    audio_files = list_audio_files(INPUT_BUCKET, INPUT_PREFIX)

    if not audio_files:
        print("❌ No audio files found.")
        return

    print(f"✅ Found {len(audio_files)} audio files. Filtering unprocessed...\n")

    unprocessed = []
    skipped = 0
    for audio_key in audio_files:
        base_name = os.path.splitext(os.path.basename(audio_key))[0]
        if is_transcript_ready(base_name):
            print(f"⏭️  SKIPPED (Transcript exists): {audio_key}")
            skipped += 1
            continue
        input_s3_uri = f"s3://{INPUT_BUCKET}/{audio_key}"
        output_s3_uri = f"s3://{OUTPUT_BUCKET}/{TRANSCRIPT_PREFIX}{base_name}_transcript.json"
        unprocessed.append({"input_s3_uri": input_s3_uri, "output_s3_uri": output_s3_uri})

    print(f"📦 {len(unprocessed)} files need processing ({skipped} already done). Building manifests...\n")

    if not unprocessed:
        print("🎉 Nothing to do — all files already processed.")
        return

    submitted = 0
    for chunk_idx, chunk in enumerate(chunk_list(unprocessed, CHUNK_SIZE)):
        manifest_key = f"{MANIFEST_PREFIX}manifest_{chunk_idx}_{len(chunk)}files.json"
        manifest_s3_uri = f"s3://{OUTPUT_BUCKET}/{manifest_key}"

        # Upload the manifest
        s3.put_object(
            Bucket=OUTPUT_BUCKET,
            Key=manifest_key,
            Body=json.dumps(chunk, ensure_ascii=False).encode('utf-8'),
            ContentType='application/json; charset=utf-8'
        )

        try:
            response = batch.submit_job(
                jobName=f"asr-batch-{chunk_idx}",
                jobQueue=JOB_QUEUE,
                jobDefinition=JOB_DEFINITION,
                containerOverrides={
                    "environment": [
                        {"name": "MANIFEST_S3_URI", "value": manifest_s3_uri},
                        {"name": "HF_TOKEN", "value": HF_TOKEN},
                        {"name": "LANGUAGE", "value": LANGUAGE},
                        {"name": "NUM_SPEAKERS", "value": str(NUM_SPEAKERS)},
                        {"name": "TASK", "value": "transcribe"}
                    ]
                }
            )
            print(f"✅ Submitted batch job {chunk_idx} ({len(chunk)} files) → Job ID: {response['jobId']}")
            submitted += 1
        except Exception as e:
            print(f"❌ ERROR submitting manifest {manifest_key}: {e}")

    print(f"\n🎉 STAGE 1 COMPLETE! Submitted {submitted} jobs covering {len(unprocessed)} files ({skipped} skipped).")
    print("Wait for these jobs to finish in the AWS Batch Console before running Stage 2.")



main()
