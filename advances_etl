from pyspark.sql.window import Window


# Step 1: Define the raw data source as a view
@dp.view(
    comment='Raw Data source with no assumption about headers'
)
def raw_data():
    return (
        spark.read.format('csv')
        .option('header','false')
        .load(input_path)
    )

# Step 2: Add a row number column to help indentify the header row deterministically
@dp.view(
    comment='Raw data with row numbers added to identify the header row'
)
def raw_data_with_row_number():
    raw_data = raw_data()
    row_number_window = Window.orderBy(F.lit(1))
    return raw_data.withColumn('row_number',F.row_number().over(row_number_window))
    

