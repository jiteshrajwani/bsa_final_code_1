@dp.view(
    comment='Filtered data starting from the row below the header'
)
def cleaned_data():
    raw_data_with_row_number = raw_data_with_row_number()

    # Locate the header row using a robust method
    header_row_df = raw_data_with_row_number.filter(F.trim(F.col('_c0')) == 'Sl.No.')

    # Collect the row ID of the header
    header_row_id = header_row_df.select('row_number').first()[0]

    # Extract header columns
    header_columns = [
        str(col).strip() 
        for col in header_row_df.drop('row_number').first()
    ]

    @dp.expect_or_fail(
        "check_required_columns",
        f"size(array_except(array('{','.join(REQUIRED_COLUMNS)}'), array({','.join([f'`{col}`' for col in header_columns])}))) = 0"
    )
    def validate_columns():
        pass

    # Filter data starting from the rows after the header
    filtered_df = raw_data_with_row_number.filter(F.col('row_number') > header_row_id).drop('row_number')

    return filtered_df.toDF(*header_columns)

