import databricks.sdk.logger.round_trip_logger as rtl

for _name in dir(rtl):
    _obj = getattr(rtl, _name)
    if isinstance(_obj, type) and hasattr(_obj, "_redacted_dump"):
        _original_dump = _obj._redacted_dump

        def _safe_redacted_dump(self, prefix, body, _orig=_original_dump):
            try:
                return _orig(self, prefix, body)
            except Exception:
                if body is None:
                    return f"{prefix}(no body)"
                if isinstance(body, (bytes, bytearray)):
                    return f"{prefix}<binary body, {len(body)} bytes, not shown>"
                return f"{prefix}<unrepresentable body: {type(body).__name__}>"

        _obj._redacted_dump = _safe_redacted_dump
