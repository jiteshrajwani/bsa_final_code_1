%macro cumm1_staff(data=,var=,final_data=,m=);
proc sort data=&data;
by staffid month;
run;
proc sql;
	create table staff1_l as 
	select max(B.&var.) as MAX_&m.M_&var.,min(b.&var.) as Min_&m.M_&var.,
	mean(b.&var.) As Avg_&m.M_&var.,
    exp(mean(log(max(b.&var.,1)))) as geo_mean_&m.M_&var.,
    A.staffid, A.month,A.branch_id
	from 
&data as A
	left join 
&data as B
	on A.staffid = B.staffid 
	where A.month > B.month and INTCK('month',A.month,B.month) <&m
	group by A.staffid, A.month,A.branch_id;
quit;
Proc sql;
create table branch as
select branch_id,month,sum(&var) as &var
from &data
group by 1,2;
quit;
proc sql;
	create table br_1 as 
	select max(B.&var.) as MAX_&m.M_&var._bma,min(b.&var.) as Min_&m.M_&var._bma,
	mean(b.&var.) As Avg_&m.M_&var._bma,A.branch_id, A.month
	from 
	branch as A
	left join 
	branch as B
	on A.branch_id = B.branch_id 
	where A.month> B.month and INTCK('month',A.month,B.month) <&m
	group by A.branch_id, A.month;
quit;

proc sql;
	create table br_2 as 
	select max(A.&var.) as MAX_&m.M_&var._bc,
	min(A.&var.) as Min_&m.M_&var._bc,
 
	mean(A.&var.) As Avg_&m.M_&var._bc,A.branch_id, A.month
	from 
&data as A
	group by A.branch_id, A.month;
quit;

data br_map;
merge br_1 br_2;
by branch_id month;
run;
data staff_map;
merge staff1_l &data;
by staffid month;
run;
Proc sort data=staff_map;
by branch_id month;
run;
data fin_cumm_&var;
merge staff_map br_map;
by branch_id month;
run;
proc sort data=fin_cumm_&var;
     by branch_id month ;
run;
proc rank data= fin_cumm_&var out= ranked_st descending ties=dense;
     by branch_id month ;
     var &var.;
     ranks rank_&m.M_&var.;
run;

 
Proc sql;
create table rank_max as
select branch_id,month,
max(rank_&m.M_&var.) as max_rank_&m.M_&var.
/*max_rank_&m.M_&var*/
/*min(rank_&m.M_&var.) as min_rank_&m.M_&var.*/
from ranked_st
group by 1,2;
quit;
data &final_data.;
retain staffid branch_id month;
merge fin_cumm_&var ranked_st rank_max ;
staffid=compress(staffid);
by branch_id month;
if branch_id ne "";
v1_&m.M_&var.=&var./MAX_&m.M_&var._bc;
 
if MIN_&m.M_&var._bc >0 then do;
v2_&m.M_&var.=&var./MIN_&m.M_&var._bc;
end;
else v2_&m.M_&var.= -99;
v3_&m.M_&var.=&var./AVG_&m.M_&var._bc;
v4_&m.M_&var.=&var./MAX_&m.M_&var._bma;
 
if MIN_&m.M_&var._bma>0 then do;
v5_&m.M_&var.=&var./MIN_&m.M_&var._bma;
end;
else v5_&m.M_&var.=-99;
v6_&m.M_&var.=&var./AVG_&m.M_&var._bma;
if Min_&m.M_&var.>0 then do;
v7_&m.M_&var.=&var./Min_&m.M_&var.;
end;
else v7_&m.M_&var. = -99; 
v8_&m.M_&var.=&var./Max_&m.M_&var.;
v9_&m.M_&var.=&var./Avg_&m.M_&var.;
v10_&m.M_&var.=&var./geo_mean_&m.M_&var.;
v11_&m.M_&var.=&var./max_rank_&m.M_&var.;
v12_&m.M_&var.=AVG_&m.M_&var./MAX_&m.M_&var._bc;
v13_&m.M_&var.=MAX_&m.M_&var./MAX_&m.M_&var._bc;
if MIN_&m.M_&var._bc>0 then do;
v14_&m.M_&var.=MIN_&m.M_&var./MIN_&m.M_&var._bc;
end;
else v14_&m.M_&var. = -99;
/*v15_&var.=MAX_&var._bc/MIN_&var._bc;*/
if &var.>MIN_&m.M_&var._bc then do;
v15_&m.M_&var.=(MAX_&m.M_&var._bc-&var.)/(&var.-MIN_&m.M_&var._bc);
end;
else v15_&m.M_&var.=-99;
/*v17_&var.=MAX_&var._bc/MAX_&var._bma;*/
run;
proc sort data=&final_data. nodupkey;
by staffid month;
run;
%mend;


