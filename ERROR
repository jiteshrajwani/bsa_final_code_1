# MAGIC %md
# MAGIC # Cumulative Staff/Branch Ratio Features — PySpark (Databricks Serverless)
# MAGIC
# MAGIC Port of `%cumm1_staff(data=, var=, final_data=, m=)`. This returns a function rather than a
# MAGIC fixed output table, since the original only ever produced a transient WORK-library dataset —
# MAGIC call it and `.saveAsTable(...)` the result wherever you actually need it persisted.
# MAGIC
# MAGIC ## Read this before trusting the numbers
# MAGIC
# MAGIC 1. **Likely bug in the trailing-window filter — fixed here, flagged loudly.** Both self-joins in
# MAGIC    the original used:
# MAGIC    `where A.month > B.month and INTCK('month', A.month, B.month) < &m`
# MAGIC    `INTCK('month', start, end)` is negative whenever `end` is before `start`. Here `A.month`
# MAGIC    (the *later* month) is passed as `start` and `B.month` (the *earlier* month) as `end`, so the
# MAGIC    result is always ≤ -1 whenever `A.month > B.month` — which is always `< &m` for any normal
# MAGIC    positive `m` (3, 6, 12...). The filter never actually excludes anything: every call computes
# MAGIC    over **full history**, not a trailing `m`-month window, no matter what `m` is. The column
# MAGIC    names (`MAX_3M_var`, `v9_6M_var`, ...) say "M months," but the number underneath was
# MAGIC    full-history all along.
# MAGIC    Below, `m` bounds what the column names say it bounds — trailing `m` calendar months, current
# MAGIC    month excluded — using an integer month index (`year*12 + month`) and `rangeBetween(-m, -1)`.
# MAGIC    If you need bit-for-bit parity with the original's actual (unbounded) behavior instead — e.g.
# MAGIC    a model was already trained on it — call with `full_history=True` and the window bound is
# MAGIC    dropped entirely.
# MAGIC 2. **Both self-joins replaced with window functions.** A self-join per staff/branch per month
# MAGIC    scales badly; `rangeBetween` over a partitioned, ordered window gets the same trailing-window
# MAGIC    aggregates in one sorted pass. `rangeBetween` (not `rowsBetween`) is deliberate — it respects
# MAGIC    actual calendar gaps if a staff member has a missing month, where a row-count window would not.
# MAGIC 3. **`PROC RANK` + re-merge collapsed into one more window function** (`dense_rank()`), since
# MAGIC    ranking a column and pulling each group's max rank doesn't need its own table round-trip here.
# MAGIC 4. **`max(var, 1)` inside the geo-mean, before `log()`, floors missing values at 1 — to match SAS.**
# MAGIC    SAS treats a missing numeric value as smaller than any real number, so `max(., 1)` evaluates
# MAGIC    to `1`. Spark's `greatest()` returns `NULL` if either input is `NULL`, so a plain
# MAGIC    `F.greatest(col, F.lit(1))` would silently drop those rows from the geo-mean instead of
# MAGIC    flooring them — handled explicitly below.
# MAGIC 5. **`SAS COMPRESS()` on `staffid`** replicated with the same blank-stripping helper as the
# MAGIC    earlier script.
# MAGIC
# MAGIC Expected input schema for `data`: one row per `staffid` + `month` (DateType, first-of-month) +
# MAGIC `branch_id` + the numeric column named by `var`. Rename columns before calling if your source
# MAGIC uses different names (e.g. `empid`/`branchid` in `emp_fin_dtls`) — see the example at the bottom.

# COMMAND ----------

from pyspark.sql import DataFrame, functions as F
from pyspark.sql.window import Window


def compress_(col):
    """SAS COMPRESS(): strips ALL blanks (not just leading/trailing)."""
    return F.regexp_replace(col.cast("string"), " ", "")


def cumm_staff_features(data: DataFrame, var: str, m: int, full_history: bool = False) -> DataFrame:
    """
    PySpark port of %cumm1_staff(data=, var=, final_data=, m=).

    Parameters
    ----------
    data : DataFrame with columns staffid, month (date, first-of-month), branch_id, <var>
    var  : name of the numeric column to build trailing/ratio features for
    m    : trailing window length in months (see note above on what this bounds)
    full_history : if True, reproduces the original SAS's actual (unbounded) behavior instead of a
                   true trailing m-month window

    Returns a DataFrame keyed by (staffid, month) with the same v1..v15 ratio columns as the SAS macro.
    """
    suf = f"{m}M_{var}"
    df = data.withColumn("month_idx", F.year("month") * 12 + F.month("month"))

    if full_history:
        staff_window = Window.partitionBy("staffid").orderBy("month_idx").rangeBetween(
            Window.unboundedPreceding, -1
        )
        branch_window = Window.partitionBy("branch_id").orderBy("month_idx").rangeBetween(
            Window.unboundedPreceding, -1
        )
    else:
        staff_window = Window.partitionBy("staffid").orderBy("month_idx").rangeBetween(-m, -1)
        branch_window = Window.partitionBy("branch_id").orderBy("month_idx").rangeBetween(-m, -1)

    # SAS's max(var, 1) treats a missing var as smaller than 1, so it floors to 1; Spark's greatest()
    # would instead propagate NULL. This replicates the SAS floor explicitly.
    var_floor1 = F.when(F.col(var).isNull(), F.lit(1)).otherwise(F.greatest(F.col(var), F.lit(1)))

    # ---- staff-level trailing stats (was staff1_l, built via self-join) ----
    staff_stats = (
        df.withColumn(f"MAX_{suf}", F.max(var).over(staff_window))
        .withColumn(f"Min_{suf}", F.min(var).over(staff_window))
        .withColumn(f"Avg_{suf}", F.avg(var).over(staff_window))
        .withColumn(f"geo_mean_{suf}", F.exp(F.avg(F.log(var_floor1)).over(staff_window)))
    )

    # ---- branch-month totals, then trailing branch stats (was br_1, self-join on `branch`) ----
    branch_totals = df.groupBy("branch_id", "month", "month_idx").agg(F.sum(var).alias(var))
    branch_bma = branch_totals.select(
        "branch_id",
        "month",
        F.max(var).over(branch_window).alias(f"MAX_{suf}_bma"),
        F.min(var).over(branch_window).alias(f"Min_{suf}_bma"),
        F.avg(var).over(branch_window).alias(f"Avg_{suf}_bma"),
    )

    # ---- branch cross-sectional stats, current month across staff (was br_2) ----
    branch_bc = df.groupBy("branch_id", "month").agg(
        F.max(var).alias(f"MAX_{suf}_bc"),
        F.min(var).alias(f"Min_{suf}_bc"),
        F.avg(var).alias(f"Avg_{suf}_bc"),
    )

    # ---- assemble (was the staff_map / br_map / fin_cumm_&var merges) ----
    combined = staff_stats.join(branch_bma, on=["branch_id", "month"], how="left").join(
        branch_bc, on=["branch_id", "month"], how="left"
    )

    # ---- rank within branch/month, descending, dense (was PROC RANK + rank_max re-merge) ----
    rank_window = Window.partitionBy("branch_id", "month").orderBy(F.col(var).desc())
    group_window = Window.partitionBy("branch_id", "month")

    combined = combined.withColumn(f"rank_{suf}", F.dense_rank().over(rank_window))
    combined = combined.withColumn(f"max_rank_{suf}", F.max(F.col(f"rank_{suf}")).over(group_window))

    # ---- final ratio features (was the last data step) ----
    v = F.col(var)
    result = (
        combined.withColumn("staffid", compress_(F.col("staffid")))
        .filter(F.col("branch_id").isNotNull() & (F.col("branch_id").cast("string") != ""))
        .withColumn(f"v1_{suf}", v / F.col(f"MAX_{suf}_bc"))
        .withColumn(
            f"v2_{suf}",
            F.when(F.col(f"Min_{suf}_bc") > 0, v / F.col(f"Min_{suf}_bc")).otherwise(F.lit(-99)),
        )
        .withColumn(f"v3_{suf}", v / F.col(f"Avg_{suf}_bc"))
        .withColumn(f"v4_{suf}", v / F.col(f"MAX_{suf}_bma"))
        .withColumn(
            f"v5_{suf}",
            F.when(F.col(f"Min_{suf}_bma") > 0, v / F.col(f"Min_{suf}_bma")).otherwise(F.lit(-99)),
        )
        .withColumn(f"v6_{suf}", v / F.col(f"Avg_{suf}_bma"))
        .withColumn(
            f"v7_{suf}",
            F.when(F.col(f"Min_{suf}") > 0, v / F.col(f"Min_{suf}")).otherwise(F.lit(-99)),
        )
        .withColumn(f"v8_{suf}", v / F.col(f"MAX_{suf}"))
        .withColumn(f"v9_{suf}", v / F.col(f"Avg_{suf}"))
        .withColumn(f"v10_{suf}", v / F.col(f"geo_mean_{suf}"))
        .withColumn(f"v11_{suf}", v / F.col(f"max_rank_{suf}"))
        .withColumn(f"v12_{suf}", F.col(f"Avg_{suf}") / F.col(f"MAX_{suf}_bc"))
        .withColumn(f"v13_{suf}", F.col(f"MAX_{suf}") / F.col(f"MAX_{suf}_bc"))
        .withColumn(
            f"v14_{suf}",
            F.when(
                F.col(f"Min_{suf}_bc") > 0, F.col(f"Min_{suf}") / F.col(f"Min_{suf}_bc")
            ).otherwise(F.lit(-99)),
        )
        .withColumn(
            f"v15_{suf}",
            F.when(
                v > F.col(f"Min_{suf}_bc"),
                (F.col(f"MAX_{suf}_bc") - v) / (v - F.col(f"Min_{suf}_bc")),
            ).otherwise(F.lit(-99)),
        )
        .drop("month_idx")
        .dropDuplicates(["staffid", "month"])
        # nodupkey guard from the original — should be a no-op if staffid/month is already unique,
        # which it will be by construction unless the source `data` itself has duplicate rows on that key
    )

    return result


