function setStamp(name, state) {
  stamps[name].classList.remove('active', 'done', 'error');
  if (state) stamps[name].classList.add(state);
}

function rejectNotABankStatement(message) {
  progressStage.classList.add('hidden');
  resultStage.classList.add('hidden');
  uploadStage.classList.remove('hidden');
  filenameEl.classList.add('hidden');
  rejectMessageEl.textContent = message;
  rejectMessageEl.classList.remove('hidden');
}
