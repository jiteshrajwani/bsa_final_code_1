    .orderBy("line_no")
    .select("line_no", "txn_date_raw", "debit_amount", "credit_amount", "running_balance")
    .collect()
)

first_row, last_row = rows[0], rows[-1]
first_date, last_date = _parse_date_loose(first_row["txn_date_raw"]), _parse_date_loose(last_row["txn_date_raw"])

print("first_row:", first_row, "-> parsed:", first_date)
print("last_row:", last_row, "-> parsed:", last_date)
print("would swap:", bool(first_date and last_date and last_date < first_date))
