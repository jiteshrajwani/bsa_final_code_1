def build_flow_metrics(m1_dt: date, m2_dt: date) -> DataFrame:
    m1_suffix = month_suffix(m1_dt)
    m2_suffix = month_suffix(m2_dt)

    m1_table, m1_use_etl = _resolve_flow_source(m1_suffix)
    m2_table, m2_use_etl = _resolve_flow_source(m2_suffix)

    # SAS:
    # b = m1 = previous month
    # a = m2 = current month
    #
    # The Branch_Type and Type_New filters are applied only to b.

    b_filter = (
        (F.col("Branch_Type") == "SMPT")
        & (F.col("Type_New") == "Advances")
    )

    if m1_use_etl:
        b_filter = b_filter & (F.col("ETL_IS_ACTIVE") == "1")

    b = (
        spark.table(m1_table)
        .filter(b_filter)
        .select(
            "ZoneName",
            "StateName",
            "Region",
            "BranchID",
            "centerstaffid",
            "CLIENTID",
            "Ageing",
        )
    )

    a = spark.table(m2_table)

    if m2_use_etl:
        a = a.filter(F.col("ETL_IS_ACTIVE") == "1")

    a = a.select(
        "CLIENTID",
        "Ageing",
    )

    clientwise = (
        b.alias("b")
        .join(
            a.alias("a"),
            F.col("a.CLIENTID") == F.col("b.CLIENTID"),
            "left",
        )
        .select(
            F.col("b.ZoneName").alias("zone"),
            F.col("b.StateName").alias("state"),
            F.col("b.Region").alias("region"),
            F.col("b.BranchID").alias("branchid"),
            F.col("b.centerstaffid").alias("staff_id"),
            F.col("b.CLIENTID").alias("clientid"),
            F.col("b.Ageing").alias("ageing_pm"),
            F.col("a.Ageing").alias("ageing_cm"),
        )
    )

    fresh_flow_cond = (
        (F.col("ageing_pm") == "Current1")
        & F.col("ageing_cm").isin(
            "[1 To 30]",
            "[31 To 60]",
            "[61 To 90]",
            "[>90]",
        )
    )

    frwd_flow_cond = (
        (
            (F.col("ageing_pm") == "[1 To 30]")
            & F.col("ageing_cm").isin(
                "[31 To 60]",
                "[61 To 90]",
                "[>90]",
            )
        )
        | (
            (F.col("ageing_pm") == "[31 To 60]")
            & F.col("ageing_cm").isin(
                "[61 To 90]",
                "[>90]",
            )
        )
        | (
            (F.col("ageing_pm") == "[61 To 90]")
            & (F.col("ageing_cm") == "[>90]")
        )
    )

    npa_flow_cond = (
        (F.col("ageing_pm") != "[>90]")
        & (F.col("ageing_cm") == "[>90]")
    )

    m_1_30_cond = (
        (F.col("ageing_pm") == "Current1")
        & (F.col("ageing_cm") == "[1 To 30]")
    )

    return (
        clientwise
        .groupBy(
            "zone",
            "state",
            "region",
            "branchid",
            "staff_id",
        )
        .agg(
            F.countDistinct("clientid").alias("tot_client"),

            F.countDistinct(
                F.when(fresh_flow_cond, F.col("clientid"))
            ).alias("fresh_flow"),

            F.countDistinct(
                F.when(frwd_flow_cond, F.col("clientid"))
            ).alias("frwd_flow"),

            F.countDistinct(
                F.when(npa_flow_cond, F.col("clientid"))
            ).alias("npa_flow"),

            F.countDistinct(
                F.when(m_1_30_cond, F.col("clientid"))
            ).alias("m_1_30"),
        )
        .withColumn("month", F.lit(month_begin(m2_dt)))
    )
