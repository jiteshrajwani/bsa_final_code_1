	create table br_1 as 
	select max(B.&var.) as MAX_&m.M_&var._bma,min(b.&var.) as Min_&m.M_&var._bma,
	mean(b.&var.) As Avg_&m.M_&var._bma,A.branch_id, A.month
	from 
	branch as A
	left join 
	branch as B
	on A.branch_id = B.branch_id 
