SELECT DISTINCT
        A.BRANCH_CODE AS IBLBRANCHCODE,
        C.SOL_DESC AS IBLBRANCHNAME,
        A.CUSTOMER_NO AS CUSTOMERNO,
        A.ACCOUNT_NO AS ACCOUNTNUMBER,
        CAST(A.ACCT_OPN_DATE AS DATE) AS ACCOUNTOPENDATE,
        (CASE WHEN UPPER(A.SCHM_CODE) IN ('RDMIS','RDMIC','RDBFL','RDSBL') THEN 'RD'
              WHEN UPPER(A.SCHM_CODE) IN ('TRMIS','TRMIC','TDBFL','TDSBL') THEN 'FD'
         END) AS ACCOUNTTYPE,
        A.SCHM_CODE AS SCHEMECODE,
        A.C5CODE,
        A.CLASSIFICATION_CODE AS P2CODE,
        (CASE WHEN CAST(A.ACCT_OPN_DATE AS DATE) <= '2026-03-31' THEN 'ETB' ELSE 'NTB' END) AS IS_ETB_NTB,
        A.ACCT_CLS_DATE AS CLOSUREDATE,
        'MFI' AS SBU
FROM EDP_DATAWAREHOUSE_PRD.EDW.DIMACCOUNT AS A
JOIN EDP_DATAWAREHOUSE_PRD.EDW.DIMACCOUNT AS B
  ON B.CUSTOMER_NO = A.CUSTOMER_NO
LEFT JOIN EDP_CURATED_DATAMART_PRD.FINACLE.SOL AS C ON C.SOL_ID = A.BRANCH_CODE
WHERE A.ISDELETE = 0
  AND UPPER(A.SCHM_TYPE) = 'TDA'
  AND UPPER(A.SCHM_CODE) IN ('RDMIS','RDMIC','RDBFL','RDSBL','TRMIS','TRMIC','TDBFL','TDSBL')
  AND (A.ACCT_CLS_DATE IS NULL OR CAST(A.ACCT_CLS_DATE AS DATE) >= '2026-04-01')
  AND B.ISDELETE = 0
  AND UPPER(B.SCHM_TYPE) IN ('SBA','CAA')
  AND (
        (UPPER(B.SCHM_CODE) = 'SBINP' AND UPPER(B.C5CODE) = 'LA')
        OR (UPPER(B.SCHM_CODE) = 'SBMIC' AND UPPER(B.C5CODE) IN ('BM','BN','LA'))
      );
