%macro fresh_frwd_flow(m1=,m2=);

proc sql;

    create table clientwise as
        select 
            b.ZoneName,
            b.StateName,
            b.Region,
            b.Area,
            b.BranchID,
            b.BranchName,
            b.clientid,
            b.clientcode,
			b.clientloanid,
            b.Clientname,
            b.centerstaffid,
            b.Ageing as Ageing_PM,
            a.Ageing as Ageing_CM,
            a.Client_DPD as NoOfDaysInArrears_CM,
            coalesce(b.Client_DPD, 0) as NoOfDaysInArrears_PM,
            a.POS as POS_CM,
            b.POS as POS_PM
        from PTSD.P_loanfacts_&m1 b
        left join PTSD.P_loanfacts_&m2 a 
            on a.CLIENTID = b.CLIENTID
        where b.Branch_Type = 'SMPT' and b.Type_New ='Advances';
quit;



proc sql;
create table clientwise_&m2 as 
select zonename as zone, statename as state, region, branchid, 
centerstaffid as staff_id,intnx('month',input("&m2",monyy.),0,'B') format = date9. format = date9. as month,
count(distinct CLIENTID) as tot_client,
count(distinct case when ageing_pm eq 'Current1' and 
ageing_cm in ('[1 To 30]','[31 To 60]','[61 To 90]','[>90]') then CLIENTID end) as fresh_flow, 
count(distinct case
  when (ageing_pm = '[1 To 30]' and ageing_cm in ('[31 To 60]','[61 To 90]','[>90]'))
    or (ageing_pm = '[31 To 60]' and ageing_cm in ('[61 To 90]','[>90]'))
    or (ageing_pm = '[61 To 90]' and ageing_cm in ('[>90]'))
  then CLIENTID
end) as frwd_flow,
count(distinct case when ageing_pm ne '[>90]' and ageing_cm eq '[>90]' then CLIENTID end) as npa_flow

from clientwise
group by 1,2,3,4,5,6;
quit;

%mend;

%fresh_frwd_flow(m1=oct25,m2=nov25);


def build_flow_metrics(m1_dt: date, m2_dt: date) -> DataFrame:
    m1_suffix = month_suffix(m1_dt)
    m2_suffix = month_suffix(m2_dt)

    m1_table, m1_use_etl = _resolve_flow_source(m1_suffix)
    m2_table, m2_use_etl = _resolve_flow_source(m2_suffix)

    # SAS:
    # b = m1 = previous month
    # a = m2 = current month
    #
    # The Branch_Type and Type_New filters are applied only to b.

    b_filter = (
        (F.col("Branch_Type") == "SMPT")
        & (F.col("Type_New") == "Advances")
    )
    a_filter = (
        (F.col("Branch_Type") == "SMPT")
        & (F.col("Type_New") == "Advances")
    )

    if m1_use_etl:
        b_filter = b_filter & (F.col("ETL_IS_ACTIVE") == "1")

    b = (
        spark.table(m1_table)
        .filter(b_filter)
        .select(
            "ZoneName",
            "StateName",
            "Region",
            "BranchID",
            "centerstaffid",
            "CLIENTID",
            "Ageing",
        )
    )

    a = spark.table(m2_table)

    if m2_use_etl:
        a = a_filter & (F.col("ETL_IS_ACTIVE") == "1")

    a = (
        spark.table(m2_table)
        .filter(a_filter)
        .select(
        "CLIENTID",
        "Ageing",
        )
    )
    clientwise = (
        b.alias("b")
        .join(
            a.alias("a"),
            F.col("a.CLIENTID") == F.col("b.CLIENTID"),
            "left",
        )
        .select(
            F.col("b.ZoneName").alias("zone"),
            F.col("b.StateName").alias("state"),
            F.col("b.Region").alias("region"),
            F.col("b.BranchID").alias("branchid"),
            F.col("b.centerstaffid").alias("staff_id"),
            F.col("b.CLIENTID").alias("clientid"),
            F.col("b.Ageing").alias("ageing_pm"),
            F.col("a.Ageing").alias("ageing_cm"),
        )
    )

    fresh_flow_cond = (
        (F.col("ageing_pm") == "Current1")
        & F.col("ageing_cm").isin(
            "[1 To 30]",
            "[31 To 60]",
            "[61 To 90]",
            "[>90]",
        )
    )

    frwd_flow_cond = (
        (
            (F.col("ageing_pm") == "[1 To 30]")
            & F.col("ageing_cm").isin(
                "[31 To 60]",
                "[61 To 90]",
                "[>90]",
            )
        )
        | (
            (F.col("ageing_pm") == "[31 To 60]")
            & F.col("ageing_cm").isin(
                "[61 To 90]",
                "[>90]",
            )
        )
        | (
            (F.col("ageing_pm") == "[61 To 90]")
            & (F.col("ageing_cm") == "[>90]")
        )
    )

    npa_flow_cond = (
        (F.col("ageing_pm") != "[>90]")
        & (F.col("ageing_cm") == "[>90]")
    )

    m_1_30_cond = (
        (F.col("ageing_pm") == "Current1")
        & (F.col("ageing_cm") == "[1 To 30]")
    )

    return (
        clientwise
        .groupBy(
            "zone",
            "state",
            "region",
            "branchid",
            "staff_id",
        )
        .agg(
            F.countDistinct("clientid").alias("tot_client"),

            F.countDistinct(
                F.when(fresh_flow_cond, F.col("clientid"))
            ).alias("fresh_flow"),

            F.countDistinct(
                F.when(frwd_flow_cond, F.col("clientid"))
            ).alias("frwd_flow"),

            F.countDistinct(
                F.when(npa_flow_cond, F.col("clientid"))
            ).alias("npa_flow"),

            F.countDistinct(
                F.when(m_1_30_cond, F.col("clientid"))
            ).alias("m_1_30"),
        )
        .withColumn("month", F.lit(month_begin(m2_dt)))
    )
