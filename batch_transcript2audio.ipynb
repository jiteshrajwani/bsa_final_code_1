import os
import json
import boto3
from botocore.exceptions import ClientError

s3 = boto3.client('s3', region_name='ap-south-1')
batch = boto3.client('batch', region_name='ap-south-1')

INPUT_BUCKET = "test-audit-ars"
INPUT_PREFIX = "transcripts/"
OUTPUT_BUCKET = "test-audit-ars"
TRANSCRIPT_PREFIX = "audits/"  # note: this is your AUDIT output prefix, reusing var name from your snippet

MANIFEST_PREFIX = "manifests-llm/"
CHUNK_SIZE = 20  # LLM inference is heavier per-item than ASR; start smaller, tune after timing a run

JOB_QUEUE = "queue-llm"       # fill in your actual LLM job queue name
JOB_DEFINITION = "job-def-llm"          # fill in your actual LLM job definition name
MODEL_ID = "sarvamai/sarvam-m"



def list_transcript_files(bucket, prefix):
    paginator = s3.get_paginator('list_objects_v2')
    pages = paginator.paginate(Bucket=bucket, Prefix=prefix)
    files = []
    for page in pages:
        if 'Contents' in page:
            for obj in page['Contents']:
                key = obj['Key']
                if key.endswith('.json'):
                    files.append(key)
    return files


def is_audit_ready(base_name):
    audit_key = f"{TRANSCRIPT_PREFIX}{base_name}_audit.json"
    try:
        s3.head_object(Bucket=OUTPUT_BUCKET, Key=audit_key)
        return True
    except ClientError as e:
        if e.response['Error']['Code'] == '404':
            return False
        raise


def chunk_list(items, size):
    for i in range(0, len(items), size):
        yield items[i:i + size]


def main():
    print(f"🔍 Scanning s3://{INPUT_BUCKET}/{INPUT_PREFIX} for transcript files...")
    transcript_files = list_transcript_files(INPUT_BUCKET, INPUT_PREFIX)

    if not transcript_files:
        print("❌ No transcript files found.")
        return

    print(f"✅ Found {len(transcript_files)} transcripts. Filtering unprocessed...\n")

    unprocessed = []
    skipped = 0
    for transcript_key in transcript_files:
        base_name = os.path.splitext(os.path.basename(transcript_key))[0].replace("_transcript", "")
        if is_audit_ready(base_name):
            print(f"⏭️  SKIPPED (Transcript exists): {audio_key}")
            skipped += 1
            continue
        input_s3_uri = f"s3://{INPUT_BUCKET}/{transcript_key}"
        output_s3_uri = f"s3://{OUTPUT_BUCKET}/{TRANSCRIPT_PREFIX}{base_name}_audit.json"
        unprocessed.append({"input_s3_uri": input_s3_uri, "output_s3_uri": output_s3_uri})

    print(f"📦 {len(unprocessed)} transcripts need auditing ({skipped} already done). Building manifests...\n")

    if not unprocessed:
        print("🎉 Nothing to do — all transcripts already audited.")
        return

    submitted = 0
    for chunk_idx, chunk in enumerate(chunk_list(unprocessed, CHUNK_SIZE)):
        manifest_key = f"{MANIFEST_PREFIX}manifest_{chunk_idx}_{len(chunk)}files.json"
        manifest_s3_uri = f"s3://{OUTPUT_BUCKET}/{manifest_key}"

        s3.put_object(
            Bucket=OUTPUT_BUCKET,
            Key=manifest_key,
            Body=json.dumps(chunk, ensure_ascii=False).encode('utf-8'),
            ContentType='application/json; charset=utf-8'
        )

        try:
            response = batch.submit_job(
                jobName=f"llm-audit-{chunk_idx}",
                jobQueue=JOB_QUEUE,
                jobDefinition=JOB_DEFINITION,
                containerOverrides={
                    "environment": [
                        {"name": "MANIFEST_S3_URI", "value": manifest_s3_uri},
                        {"name": "MODEL_ID", "value": MODEL_ID},
                    ]
                }
            )
            print(f"✅ Submitted LLM batch job {chunk_idx} ({len(chunk)} files) → Job ID: {response['jobId']}")
            submitted += 1
        except Exception as e:
            print(f"❌ ERROR submitting manifest {manifest_key}: {e}")

    print(f"\n🎉 STAGE 2 COMPLETE! Submitted {submitted} jobs covering {len(unprocessed)} transcripts ({skipped} skipped).")

main()
